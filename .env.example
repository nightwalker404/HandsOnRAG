### AI BASE VARS ###
LLM_MODEL=qwen2.5-coder:7b
OLLAMA_URL=http://localhost:12434

### EMBEDDING & RERANKING ###
EMBEDDING_MODEL=nomic-embed-text
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-12-v2

### QDRANT (Vector Database) ###
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=documents

### GARAGE (Object Storage) ###
# Generate secrets with: openssl rand -hex 32
GARAGE_RPC_SECRET=your_rpc_secret_here
GARAGE_ADMIN_TOKEN=your_admin_token_here
GARAGE_METRICS_TOKEN=your_metrics_token_here

GARAGE_ENDPOINT=http://localhost:3900
GARAGE_REGION=garage
GARAGE_ACCESS_KEY=your_access_key_here
GARAGE_SECRET_KEY=your_secret_key_here
GARAGE_BUCKET=documents
